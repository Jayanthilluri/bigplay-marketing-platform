# Copy to .env for local development (never commit the real file).
PORT=3000

# Leave GHL_API_KEY empty to run in mock mode with demo data.
GHL_API_KEY=
GHL_LOCATION_ID=

# Employee PIN for portal login. REQUIRED in live mode (no default).
# In mock mode only, an unset PIN defaults to 1234 for local testing.
EMPLOYEE_PIN=

GHL_FIELD_MEMBERSHIP_ID=membership_id
GHL_FIELD_MEMBERSHIP_STATUS=membership_status
GHL_FIELD_PROMOTION=active_promotion
GHL_FIELD_REWARD=active_reward
GHL_FIELD_REDEMPTION_STATUS=redemption_status
GHL_FIELD_REDEEMED_AT=redeemed_at

# OPTIONAL audit field: set only after creating a matching custom field in
# GHL. When unset, redeemed-by is simply not written (nothing breaks).
GHL_FIELD_REDEEMED_BY=

# Comma-separated list of allowed frontend origins (no trailing slashes).
# Production example:
#   ALLOWED_ORIGIN=https://bigplay-players-club.onrender.com
ALLOWED_ORIGIN=http://localhost:8080,http://localhost:8099

# NOTE: No SESSION_SECRET is needed — employee sessions are unsigned
# 256-bit random tokens stored server-side, so there is nothing to sign.

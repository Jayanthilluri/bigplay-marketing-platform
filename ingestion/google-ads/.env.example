# Google Ads ingestion — copy to ingestion/google-ads/.env for local runs.
# NEVER commit the real .env. In production set these in the scheduler's
# secret store. Server-side only: none of these may ever reach browser code.

# --- Google Ads API (required) ---------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
# Client (non-manager) account ID(s) to sync, 10 digits, dashes optional.
# Comma-separate several accounts: 123-456-7890,234-567-8901
GOOGLE_ADS_CUSTOMER_ID=

# --- Google Ads API (optional) ---------------------------------------------
# Manager (MCC) account ID, only if access to the client account is via an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Days re-downloaded on every recurring sync (default 7 => today-7 .. today).
GOOGLE_ADS_LOOKBACK_DAYS=7
# Backfills are split into windows of this many days (default 30).
GOOGLE_ADS_BACKFILL_CHUNK_DAYS=30
# Google Ads REST API version (default v25).
GOOGLE_ADS_API_VERSION=v25
# Max retries for transient errors (rate limits, 5xx, network). Default 5.
GOOGLE_ADS_MAX_RETRIES=5

# --- Supabase Postgres (required for live sync) -----------------------------
# Supabase dashboard -> Connect -> "Session pooler" (port 5432) or "Direct
# connection" URI. Do NOT use the transaction pooler (port 6543).
SUPABASE_DB_URL=
# require (default: encrypted), verify (encrypted + CA check; set the CA file), disable (local only)
SUPABASE_DB_SSL=require
# Path to Supabase's CA certificate (Dashboard -> Database -> SSL), for SUPABASE_DB_SSL=verify
SUPABASE_DB_SSL_CA_FILE=

# Not used by this job. The raw/staging/core/admin schemas are not exposed to
# the Supabase Data API and grant nothing to service_role, so the job writes
# over Postgres instead. See docs/google-ads-ingestion.md -> "Database access".
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
